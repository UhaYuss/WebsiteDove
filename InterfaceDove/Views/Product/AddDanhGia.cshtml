@model InterfaceDove.Models.DanhGia

@{
    ViewBag.Title = "Add Review";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Thêm đánh giá của bạn</h2>

@using (Html.BeginForm("AddDanhGia", "Product",FormMethod.Post))
{
    @Html.AntiForgeryToken()

<div class="form-horizontal">
    <hr />

    @Html.HiddenFor(model => model.MaSanPham, new { Value = ViewBag.Id })
    @Html.HiddenFor(model => model.MaNguoiMua, new { Value = ViewBag.MaNguoiMua })

    <div class="form-group">
        @Html.LabelFor(model => model.NoiDung, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.TextAreaFor(model => model.NoiDung, new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.NoiDung, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Sao, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            @Html.DropDownListFor(model => model.Sao, new SelectList(new[] { 1, 2, 3, 4, 5 }), "Select a rating", new { @class = "form-control" })
            @Html.ValidationMessageFor(model => model.Sao, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Add Review" class="btn btn-default" />
        </div>
    </div>
</div>
}

<div>
    @Html.ActionLink("Trở về đơn đã mua", "MultipleOrdersView","Home")<br />
    @Html.ActionLink("Trở về trang chủ", "Index", "Home")
</div>
