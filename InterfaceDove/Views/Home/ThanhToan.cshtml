@model InterfaceDove.Models.GioHangWithDonHang

@{
    ViewBag.Title = "Giỏ Hàng và Đơn Hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .container {
        max-width: 1080px;
        margin: 0 auto;
        padding: 20px;
    }

    h2 {
        color: #1b65c0;
    }

    p {
        margin-bottom: 10px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    th, td {
        border: 1px solid #ddd;
        padding: 8px;
        text-align: left;
    }

    th {
        background-color: #f2f2f2;
    }

    img {
        max-width: 75px;
        max-height: 75px;
        border-radius: 5px;
    }

    /* Custom Style for alignment */
    .align-right {
        text-align: right;
    }

    .btn-confirm {
        background-color: #4CAF50;
        color: white;
        padding: 10px 20px;
        text-align: center;
        text-decoration: none;
        display: inline-block;
        font-size: 16px;
        margin: 4px 2px;
        cursor: pointer;
        border-radius: 5px;
    }
</style>

<div class="container">
    <h2>Thông Tin Người Mua</h2>
    <p>Mã Người Mua: @Model.MaNguoiMua</p>
    <p>Số Điện Thoại: @Model.SoDienThoai</p>
    <p>Địa Chỉ Nhận Hàng: @Model.DiaChiNhanHang</p>
    <p>Tỉnh Thành: @Model.TinhThanh</p>
    <p>Quận Huyện: @Model.QuanHuyen</p>

    <div class="text-center align-right">
        @Html.ActionLink("Sửa Thông Tin", "LuuThongTinChinhSua", new { maNguoiMua = Model.MaNguoiMua }, new { @class = "btn btn-default" })
    </div>

    <h2>Danh Sách Sản Phẩm trong Giỏ Hàng</h2>
    <table>
        <tr>
            <th>Mã Sản Phẩm</th>
            <th>Số Lượng</th>
            <th>Ảnh Trước</th>
            <th>Đơn Giá</th>
            <th>Thành Tiền</th>
        </tr>
        @foreach (var chiTiet in Model.Gh)
        {
            <tr>
                <td>@chiTiet.MaSanPham</td>
                <td>@chiTiet.SoLuong</td>
                <td><img src="~/img/Product/@chiTiet.SanPham.HinhAnhTruoc" alt="Ảnh Trước" width="50" height="50" /></td>
                <td>@chiTiet.DonGia</td>
                <td>@(chiTiet.SoLuong * chiTiet.DonGia)</td>
            </tr>
        }
    </table>

    <div class="align-right">
        <a href="@Url.Action("ShowGH","Home")">Quay lại giỏ hàng</a>
    </div>

    <div class="align-right">
        <a href="@Url.Action("AddDonHang", "Home")" class="btn-confirm">Xác Nhận Đơn Hàng</a>
    </div>
</div>
