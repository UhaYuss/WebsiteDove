@model IEnumerable<InterfaceDove.Models.SanPham>
@{
    ViewBag.Title = "Home Page";
    Layout = "~/Views/Shared/_LayoutBanner.cshtml";
}

<style>
    .product-grid {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
    }

    .product-card {
        width: calc(25% - 20px); 
        margin: 10px;
        border: 1px solid #ccc;
        border-radius: 5px;
        padding: 10px;
        margin-bottom:20px;
    }

        .product-card img {
            width: 100%;
        }

    .add-to-cart-button {
        background-color: white;
        color: blue;
        border: 1px solid #007bff;
        padding: 10px 20px;
        border-radius: 5px;
        cursor: pointer;
    }

        .add-to-cart-button:hover {
            background-color: #007bff;
            color: white;
        }
</style>

<h2 style="text-align:center">Sản Phẩm nổi bật</h2>

<div class="product-grid">
    @foreach (var item in Model)
    {

        <div class="product-card">
            <img src="~/img/Product/@item.HinhAnhTruoc" />
            <p>@item.TenSanPham</p>
            @if(item.Sao > 0)
                {

                <p>Đánh giá @item.Sao <img style="max-width: 15px;" src="~/img/logo/star.png" /></p>
                }
                else
                {
                    <p> Sản phẩm chưa được đánh giá</p>
                }
            <p>Giá: @item.Gia VND</p>
            <a class="add-to-cart-button" href="@Url.Action("ShowSanPham", "Product", new {id = item.MaSanPham})">Xem chi tiết</a>
</div>
    }
</div>