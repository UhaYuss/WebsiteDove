@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Đăng Ký Người Mua</title>
</head>
<body>
    <div class="container">
        <div class="logo">
            <img src="~/img/Logo/logoDove.jpg" />
        </div>
        <h2>Đăng Ký Người Mua</h2>
        <form action="XacThucDangKy" method="post" onsubmit="return validateForm()">
            <label for="SoDienThoai">Số Điện Thoại:</label>
            <input type="text" name="SoDienThoai" id="SoDienThoai" required>

            <label for="MatKhau">Mật Khẩu:</label>
            <input type="password" name="MatKhau" id="MatKhau" required>

            <label>Nhập lại Mật Khẩu:</label>
            <input type="password" id="MatKhauNhapLai" required>

            <label for="HoTen">Họ Tên:</label>
            <input type="text" name="HoTen" id="HoTen" required>

            <label for="Email">Email:</label>
            <input type="email" name="Email" id="Email" required>

            <label for="DiaChi">Địa Chỉ:</label>
            <input type="text" name="DiaChi" id="DiaChi" required>

            @if (ViewBag.UserExistMessage != null)
            {
                <p class="text-danger">@ViewBag.UserExistMessage</p>
            }
            <p id="error-message" class="text-danger"></p>
            <input type="submit" class="btn" value="Đăng Ký">
        </form>
        <div class="links">
            <a href="@Url.Action("DangNhap","Home")">Đã có tài khoản?</a>
        </div>
    </div>

    <script>
        function validateForm() {
            var password = document.getElementById("MatKhau").value;
            var confirmPassword = document.getElementById("MatKhauNhapLai").value;

            if (password !== confirmPassword) {
                document.getElementById("error-message").innerHTML = "Mật khẩu nhập lại không đúng";
                return false;
            }
            return true;
        }
    </script>
</body>
</html>
